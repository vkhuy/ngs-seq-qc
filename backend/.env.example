# Backend Environment Configuration

# Server port (default: 3001)
PORT=3001

# CORS allowed origins (comma-separated)
# Examples:
# - Single origin: https://ngs-seq-qc.vercel.app
# - Multiple origins: https://ngs-seq-qc.vercel.app,https://my-domain.com
# - Wildcard patterns: https://ngs-seq-qc-git-*.vercel.app
# - Mixed: https://production.com,https://staging-*.example.com,http://localhost:3000
#
# If not set, defaults to localhost development ports for local development
CORS_ORIGINS=https://ngs-seq-qc-git-*.vercel.app

# Node environment (development|production)
NODE_ENV=production